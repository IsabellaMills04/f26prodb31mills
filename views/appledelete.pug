extends layout 

block content 
    h1=title 

    if(toShow == null)
        h2 No instance to delete 
    else
        - let appleid = toShow._id 
        - let applevariety = toShow.variety 
        - let applecolor = toShow.color 
        - let appleweight = toShow.weight 
        - let actionid = "/resource/apple/" + appleid 
        script let actionid = "#{actionid}"
        div 
            div.row
                div(class='appleAttr mr-3') Apple ID is: 
                div #{appleid}
            div.row
                div(class='appleAttr mr-3') Apple Variety is: 
                div #{applevariety}
            div.row
                div(class='appleAttr mr-3') Apple Color is: 
                div #{applecolor}
            div.row
                div(class='appleAttr mr-3') Apple Weight is: 
                div #{appleweight}
        
        button(class="btn btn-danger m-2" onclick="deleteOnid()") Delete 
        button(class="btn btn-secondary m-2" onclick="cancel()") Cancel 

        script.
            function cancel() {
                // Go back to the home page for the apple collection
                window.location.href='/apple'
            }
        script.
            function deleteOnid() {
                console.log("starting delete")
                // delete first
                fetch(actionid, {
                    method: 'DELETE'
                }).then((resp) => {
                    return resp.json();
                }).then((body) => {
                    alert("Delete succeeded")
                    window.location.href='/apple'
                    // TODO handle body
                }).catch((error) => {
                    // TODO handle error
                    alert("Delete failed " + error)
                });
            }