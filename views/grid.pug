extends layout

block content
  h1= title
  
  p Rows: #{query.rows}
  p Columns: #{query.cols}

  - let rows = Number(query.rows)
  - let col = Number(query.cols)
  - function cellValue(i, j) { return j - i }

  if !Number.isInteger(rows) || !Number.isInteger(col)
    p Both rows and cols must be integers
  else if rows < 2 || rows > 12
    p Rows must be between 2 and 12
  else if col < 2 || col > 12
    p Cols must be between 2 and 12
  else 
    table#outer 
      - for(let i=0; i<rows; i++) {
        tr
          - for(let j=0; j<col; j++) {
            td= cellValue(i, j)
          - }
      - }