extends layout

block content
  h1= title
  - let items = results;

  div(class="container-fluid")
    div(class="row")
      each item, index in results
        div(class="col-sm-2", onclick=`buy(${index})`)
          p Variety: #{item.variety}
          p Color: #{item.color}
          p Weight: #{item.weight} g
  script.
    function buy(index) {
      alert(`You purchased item ${index}.`)
    }
